// sim cfg file for the variant of RV_DM using the JTAG interface
{
  // Name of the sim cfg variant
  variant: use_jtag_interface

  // Import additional common sim cfg files.
  import_cfgs: ["{proj_root}/hw/ip/rv_dm/dv/rv_dm_base_sim_cfg.hjson"]

   // List of test specifications applicable to JTAG Mode only.
  tests: [
   {
      name: rv_dm_jtag_dmi_debug_disabled
      uvm_test_seq: rv_dm_jtag_dmi_debug_disabled_vseq
      reseed: 2
    }
    {
      name: rv_dm_scanmode
      uvm_test_seq: rv_dm_scanmode_vseq
      reseed: 1
    }
  ]

}
