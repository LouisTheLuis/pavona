{
  name: keymgr_dpe
  testpoints: [
    // KEYMGR_DPE integration tests
    {
      name: chip_sw_keymgr_dpe_key_derivation
      desc: '''Verify the keymgr_dpe advances to all states and generate identity / SW output.

            - Start keymgr_dpe, letting it derive the boot stage 0 key into slot 1.
            - Generate outputs (ACC, SW, KMAC, AES) from the boot stage 0 key.
            - Derive a boot stage 1 key from the boot stage 0 key.
            - Generate outputs and derive boot stage 2 key from the boot stage 1 key.
            - Generate outputs and derive boot stage 3 key from the boot stage 2 key.
            - Generate outputs from previous boot stage (1 and 2) keys.
            '''
      features: [
        "KEYMGR_DPE.SIDELOAD.KMAC",
        "KEYMGR_DPE.SIDELOAD.AES",
        "KEYMGR_DPE.SIDELOAD.ACC",
        "KEYMGR_DPE.DERIVE.ATTESTATION",
        "KEYMGR_DPE.GENERATE.OUTPUT",
        "KEYMGR_DPE.DPE.ADVANCE"
      ]
      stage: V2
      si_stage: SV3
      lc_states: ["PROD"]
      tests: [
        "chip_sw_keymgr_dpe_key_derivation",
        "chip_sw_keymgr_dpe_key_derivation_jitter_en",
      ]
      bazel: ["//sw/device/tests:keymgr_dpe_key_derivation_test"]
    }
  ]
}
