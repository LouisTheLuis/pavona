name: lowrisc:scafi_deprecated_dv:gpio_env:0.1
description: "GPIO DV UVM environmnt"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:ralgen
      - lowrisc:dv:cip_lib
      - lowrisc:dv:clk_rst_agent
      # gpio_reg_pkg supplies NumIOs and NumInpPeriodCounters to the
      # environment package.
      - lowrisc:scafi_deprecated_ip:gpio:0.1
    files:
      - gpio_env_pkg.sv
      - gpio_env_cfg.sv: {is_include_file: true}
      - gpio_env_cov.sv: {is_include_file: true}
      - gpio_seq_item.sv: {is_include_file: true}
      - gpio_straps_item.sv: {is_include_file: true}
      - gpio_intr_item.sv: {is_include_file: true}
      - gpio_input_item.sv: {is_include_file: true}
      - gpio_hw_write_item.sv: {is_include_file: true}
      - gpio_output_item.sv: {is_include_file: true}
      - gpio_agent_cfg.sv: {is_include_file: true}
      - gpio_sequencer.sv: {is_include_file: true}
      - gpio_rst_safe_driver.sv: {is_include_file: true}
      - gpio_rst_safe_monitor.sv: {is_include_file: true}
      - gpio_rst_safe_agent.sv: {is_include_file: true}
      - gpio_reference_model.sv: {is_include_file: true}
      - gpio_rst_safe_env_cov.sv: {is_include_file: true}
      - gpio_scoreboard.sv: {is_include_file: true}
      - gpio_rst_safe_scoreboard.sv: {is_include_file: true}
      - gpio_rst_safe_virtual_sequencer.sv: {is_include_file: true}
      - gpio_rst_safe_env.sv: {is_include_file: true}
      - gpio_env.sv: {is_include_file: true}
      - seq_lib/gpio_vseq_list.sv: {is_include_file: true}
      - seq_lib/gpio_base_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_common_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rand_intr_trigger_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_random_dout_din_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_dout_din_regs_random_rw_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_random_long_reg_writes_reg_reads_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_filter_stress_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_full_random_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_stress_all_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_intr_rand_pgm_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_intr_with_filter_rand_intr_event_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rand_straps_vseq.sv : {is_include_file: true}
      - seq_lib/gpio_rand_rst_safe_base_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_smoke_with_rand_reset_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_random_dout_din_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_dout_din_regs_random_rw_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_intr_rand_pgm_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_rand_intr_trigger_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_random_long_reg_writes_reg_reads_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_full_random_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_rand_straps_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_intr_with_filter_rand_intr_event_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_filter_stress_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_rst_safe_common_vseq.sv: {is_include_file: true}
    file_type: systemVerilogSource

generate:
  ral:
    generator: ralgen
    parameters:
      name: gpio
      ip_hjson: ../../data/gpio.hjson
    position: prepend

targets:
  default:
    filesets:
      - files_dv
    generate:
      - ral
